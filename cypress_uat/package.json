  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:report": "cypress run & mochawesome-merge cypress/reports/*.json > cypress/reports/merged-report.json & marge cypress/reports/merged-report.json -f report -o cypress/reports/html",
    "merge:reports": "mochawesome-merge cypress/reports/*.json > cypress/reports/merged-report.json",
